# Master environment variables for FINM 33200 in-class examples
# Copy this file to .env and fill in your values.
# Individual examples will reference this file from the repo root.

# WRDS credentials (for database examples)
WRDS_USERNAME=your_username_here

# Common project paths (can be overridden per-example)
DATA_DIR=./_data
OUTPUT_DIR=./_output

# Example-specific settings
DEBUG=True
MAX_ROWS=1000
