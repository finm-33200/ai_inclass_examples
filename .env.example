# Master environment variables for FINM 33200 in-class examples
# Copy this file to .env and fill in your values.
# Individual examples will reference this file from the repo root.

# WRDS credentials (for database examples)
WRDS_USERNAME=your_username_here

# LLM API keys (for basic_llm_api examples)
GOOGLE_API_KEY=your_google_ai_studio_key
OPENAI_API_KEY=your_openai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Example-specific settings
DEBUG=True
MAX_ROWS=1000
